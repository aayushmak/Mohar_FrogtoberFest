# Copy to .env and fill in. Never commit the real .env.

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://mohar:mohar@localhost:5432/mohar

# Ollama (local, open-weight models — no proprietary APIs)
OLLAMA_HOST=http://localhost:11434
REASONING_MODEL=qwen2.5:7b-instruct
EMBEDDING_MODEL=bge-m3

# GitHub public API — a token only raises rate limits; no private scopes needed
GITHUB_TOKEN=

# Confidence below this forces a verdict to needs_review (see packages/shared)
CONFIDENCE_FLOOR=0.6

# API
PORT=3000